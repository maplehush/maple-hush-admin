# Root deployment, Docker Compose 2.24.4+ and Linux containers.
# A unique project name isolates containers, default network and MySQL volume.
COMPOSE_PROJECT_NAME=maple_hush_dev
SPRING_PROFILES_ACTIVE=dev
FRONTEND_IMAGE_TAG=local
BACKEND_IMAGE_TAG=local
FRONTEND_HTTP_PORT=8090
BACKEND_MEMORY_LIMIT=1g
# Build RUN network only; set host on Linux if the default build network cannot reach registries.
BUILD_NETWORK=default

MYSQL_DATABASE=maple_hush_admin
MYSQL_USERNAME=maple_hush
REDIS_DATABASE=0
REDIS_KEY_PREFIX=maple_hush_dev
# Root-relative directory (or absolute controlled directory), not backend-relative.
SECRETS_DIR=./secrets

# True only for the first empty-database start; turn off after bootstrap.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
AUTH_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

OSS_REGION=oss-cn-beijing
OSS_BUCKET=maple-hush
OSS_PUBLIC_DOMAIN=https://maple-hush.oss-cn-beijing.aliyuncs.com
OSS_OBJECT_PREFIX=vben-admin-img/
FILE_UPLOAD_PER_MINUTE=10
FILE_UPLOAD_PER_DAY=100

# Frontend trusts only container loopback until the actual TLS gateway is known.
TRUSTED_PROXY_CIDR=127.0.0.1/32
# Backend ignores forwarded headers until its own exact proxy address is known.
SERVER_FORWARD_HEADERS_STRATEGY=none
TRUSTED_PROXY_REGEX=(?!)

# Root mode fixes BACKEND_UPSTREAM=http://backend:8080 in the frontend overlay.
# Runtime credentials are file secrets; never add them to this env file.
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21
JAVA_IMAGE=eclipse-temurin:21-jre-jammy
NODE_IMAGE=node:22-bookworm-slim
NPM_REGISTRY=https://registry.npmmirror.com
NGINX_IMAGE=nginx:1.30-alpine
