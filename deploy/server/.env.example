# 复制为服务器同目录的 .env 后填写实际值。
# 本示例不保存真实密码和密钥；修改注释不影响变量取值。

# ==============================
# Compose 项目名称
# 用于标识这套容器和网络；已有部署保持名称不变。
# ==============================
COMPOSE_PROJECT_NAME=maplehush

# ==============================
# 前后端版本
# 分别填写 TCR 中实际存在的镜像标签，可以独立更新。
# 两端涉及接口变更时，需确认所选版本相互兼容。
# ==============================
FRONTEND_VERSION=v1.0.0
BACKEND_VERSION=v1.0.0

# ==============================
# 镜像仓库地址
# 不包含版本标签，由 Compose 拼接为 镜像地址:对应版本。
# ==============================
FRONTEND_IMAGE=ccr.ccs.tencentyun.com/maplehush/maple-hush-admin-frontend
BACKEND_IMAGE=ccr.ccs.tencentyun.com/maplehush/maple-hush-admin-backend

# ==============================
# 前端宿主机端口
# Compose 仅绑定 127.0.0.1，用于服务器本机排查前端服务。
# 宿主机端口为此值，前端容器内监听端口固定为 8080。
# 网关容器通过 frontend:8080 访问，不依赖此宿主机端口。
# ==============================
FRONTEND_HTTP_PORT=8081

# ==============================
# 前端 Nginx 可信代理
# 填前端容器实际看到的上游代理 IPv4 地址或 CIDR 网段，不是域名或用户 IP。
# 此项在服务器 Compose 中必填，下方网段示例须按实际网络核实。
# 填写经核实的网关 IP（/32）或所在可信 CIDR 网段。
# 上游代理须正确设置 X-Forwarded-For / X-Forwarded-Proto，不盲目信任所有来源。
# 此值仅控制前端 Nginx；后端使用真实 IP 还需单独配置其代理信任规则。
# ==============================
TRUSTED_PROXY_CIDR=172.18.0.0/16

# ==============================
# MySQL 配置
# MYSQL_DATABASE 是应用数据库名称。
# MYSQL_USER 是应用数据库账号，不是后台页面的登录账号。
# Compose 会将该账号映射为后端使用的 MYSQL_USERNAME。
# 两个密码在服务器 .env 中填写；已有数据库保持实际账号密码一致。
# 修改这里不会自动修改已初始化数据库中的账号或密码。
# ==============================
MYSQL_DATABASE=maple_hush_admin
MYSQL_USER=maplehush
# 应用数据库账号密码。
MYSQL_PASSWORD=
# MySQL root 管理员密码。
MYSQL_ROOT_PASSWORD=

# ==============================
# Redis 配置
# REDIS_PASSWORD 是 Redis 服务与后端使用的共同连接密码。
# REDIS_DATABASE 是逻辑数据库编号，0 表示第 0 个数据库。
# REDIS_KEY_PREFIX 用于区分应用和环境的缓存、验证码及限流键。
# ==============================
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=maple_hush_admin_prod

# ==============================
# 后端认证配置
# AUTH_JWT_SECRET 用于签名和校验登录令牌。
# 执行 openssl rand -hex 32，将输出填入此处，日常更新保持不变。
# AUTH_ALLOWED_ORIGINS 填浏览器实际访问的站点 Origin。
# 包含协议和必要端口，不带 /api、页面路径或末尾斜杠。
# 多个 Origin 使用英文逗号分隔。
# ==============================
AUTH_JWT_SECRET=
AUTH_ALLOWED_ORIGINS=https://admin.maplehush.cn

# ==============================
# 首次管理员初始化
# 首次空库部署时设为 true，允许创建第一个超级管理员。
# 已有正常管理员时不会重复创建或重置密码，此时可以设为 false。
# 未填写 ADMIN_BOOTSTRAP_USERNAME 时，Compose 默认使用 admin。
# ==============================
ADMIN_BOOTSTRAP_ENABLED=true

# ==============================
# OSS 图片存储
# 依次指定地域、Bucket、公开访问域名和对象存放路径前缀。
# 启用头像上传时，在服务器 .env 填写 AccessKey ID 和 Secret。
# 使用长期 AccessKey 时 OSS_SECURITY_TOKEN 留空；STS 使用临时 Token。
# ==============================
OSS_REGION=oss-cn-beijing
OSS_BUCKET=maple-hush
OSS_PUBLIC_DOMAIN=https://maple-hush.oss-cn-beijing.aliyuncs.com
OSS_OBJECT_PREFIX=vben-admin-img/
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=

# ==============================
# 宿主机数据持久化根目录
# MySQL 数据位于此目录下的 mysql/，Redis 数据位于 redis/。
# 已有部署保持原路径；修改路径不会自动迁移旧数据。
# ==============================
DATA_ROOT=/data/maplehush
