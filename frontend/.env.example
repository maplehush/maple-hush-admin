# Frontend-only deployment; does not start backend, MySQL or Redis.
COMPOSE_PROJECT_NAME=maple_hush_frontend_dev
FRONTEND_IMAGE_TAG=local
FRONTEND_HTTP_PORT=8090
# Replace with the deployed backend origin. No /api suffix or trailing /.
# Placeholder only; HTTPS certificates are verified.
BACKEND_UPSTREAM=https://api.example.com
# Exact gateway IPv4 CIDR as seen by Nginx. Default trusts container loopback only.
TRUSTED_PROXY_CIDR=127.0.0.1/32
NODE_IMAGE=node:22-bookworm-slim
NPM_REGISTRY=https://registry.npmmirror.com
NGINX_IMAGE=nginx:1.30-alpine
