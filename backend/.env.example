# Docker Compose 2.20+; copy to .env. No runtime credentials belong in this file.
COMPOSE_PROJECT_NAME=maple_hush_backend_dev
SPRING_PROFILES_ACTIVE=dev
BACKEND_IMAGE_TAG=local
BACKEND_HTTP_PORT=8080
BACKEND_MEMORY_LIMIT=1g

# Compose creates a dedicated application account. IDE/host dev still defaults
# to root/123456 through application-dev.yml.
MYSQL_DATABASE=maple_hush_admin
MYSQL_USERNAME=maple_hush
REDIS_DATABASE=0
REDIS_KEY_PREFIX=maple_hush_dev

# Files: mysql_root_password, mysql_password, redis_password, auth_jwt_secret,
# oss_access_key_id, oss_access_key_secret, oss_security_token.
# Dev initializer uses 123456 for DB/cache passwords and a random JWT key.
# Test/prod must supply independent credentials in their own directory.
SECRETS_DIR=./secrets

# Enable only for first start of an empty database, then change back to false.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
AUTH_ALLOWED_ORIGINS=http://localhost:5999,http://127.0.0.1:5999
# Optional retention overrides (same defaults as application.yml).
# AUTH_SESSION_RETENTION_DAYS=7
# AUTH_SESSION_CLEANUP_DELAY_MS=3600000
# AUTH_USER_SNAPSHOT_TTL_SECONDS=600
# LOG_LOGIN_RETENTION_DAYS=90
# LOG_OPERATION_RETENTION_DAYS=180
# LOG_CLEANUP_ENABLED=true
# LOG_CLEANUP_DELAY_MS=3600000

OSS_REGION=oss-cn-beijing
OSS_BUCKET=maple-hush
OSS_PUBLIC_DOMAIN=https://maple-hush.oss-cn-beijing.aliyuncs.com
OSS_OBJECT_PREFIX=vben-admin-img/

# Public test/prod API traffic must pass through a TLS gateway (https:// origins).
# Ignore forwarded headers until the exact proxy address is known and trusted.
SERVER_FORWARD_HEADERS_STRATEGY=none
TRUSTED_PROXY_REGEX=(?!)
# After verifying the gateway address, use strategy=native and an exact regex:
# TRUSTED_PROXY_REGEX=^172[.]20[.]0[.]1$

# Replace with approved tags/digests when releasing; no "latest" defaults.
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21
JAVA_IMAGE=eclipse-temurin:21-jre-jammy
