# Select exactly one environment: dev, test, or prod.
SPRING_PROFILES_ACTIVE=dev

# Required for all environments. Set values in a local ignored .env or process environment.
MYSQL_USERNAME=
MYSQL_PASSWORD=
REDIS_PASSWORD=

# Optional in dev; required with explicit values in test/prod.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=maple_hush_admin
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DATABASE=0
# REDIS_KEY_PREFIX=maple_hush_dev
