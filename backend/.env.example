# Select exactly one environment: dev, test, or prod.
SPRING_PROFILES_ACTIVE=dev

# Dev defaults; optional overrides for local development only.
# Test and prod require separate credentials supplied by their runtime environments.
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
REDIS_PASSWORD=123456

# Enable only for the first start of an empty database, then turn off.
# ADMIN_BOOTSTRAP_ENABLED=true
# ADMIN_BOOTSTRAP_USERNAME=admin
# Optional in dev: without this, access tokens use an ephemeral process key.
# Required in test/prod: set a distinct secret of at least 32 UTF-8 bytes.
# AUTH_JWT_SECRET=

# Optional in dev; required with explicit values in test/prod.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=maple_hush_admin
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DATABASE=0
# REDIS_KEY_PREFIX=maple_hush_dev
